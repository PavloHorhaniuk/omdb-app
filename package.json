{
  "name": "omdb-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run _serve-backend\" \"vite\"",
    "_serve-backend": "npm --prefix ../my-json-db run dev",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "@pnotify/core": "^5.2.0",
    "basiclightbox": "^5.0.4",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "gh-pages": "^6.3.0",
    "vite": "^5.4.21"
  }
}
